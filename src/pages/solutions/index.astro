---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/ui/Card.astro";

const solutions = [
  {
    icon: "🤖",
    title: "AI 软件开发",
    description: "大模型应用、NLP、计算机视觉、智能决策系统。从模型训练到工程部署，端到端交付。",
    href: "/solutions/ai-software",
  },
  {
    icon: "⚙️",
    title: "机器人技术",
    description: "ROS/ROS2 系统集成、自主导航、机械臂控制、机器人集群调度。",
    href: "/solutions/robotics",
  },
  {
    icon: "🎨",
    title: "数字创意",
    description: "实时交互体验、WebGL 可视化、数字孪生、沉浸式展厅方案。",
    href: "/solutions/digital-creative",
  },
];
---

<BaseLayout title="解决方案">
  <section class="min-h-screen pt-24 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">解决方案</h1>
      <p class="text-gray-500 mb-12 max-w-2xl">
        深耕三大技术方向，为不同行业提供专业的技术解决方案。
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {solutions.map((s) => (
          <Card
            icon={s.icon}
            title={s.title}
            description={s.description}
            href={s.href}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
