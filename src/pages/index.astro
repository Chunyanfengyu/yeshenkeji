---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import Features from "../components/sections/Features.astro";
import TechStack from "../components/sections/TechStack.astro";
import Partners from "../components/sections/Partners.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="首页">
  <Hero />
  <Features />
  <TechStack />

  <section class="py-16 sm:py-24 bg-deepgray/50">
    <div class="max-w-[1080px] mx-auto px-6 sm:px-12">
      <div class="section-border pb-8 mb-8">
        <h2 class="text-2xl font-bold text-white mb-2">// 产品推荐</h2>
        <p class="text-gray-400 text-sm">物语 AI 角色聊天平台 · 即开即用</p>
      </div>

      <div class="border border-white/10 p-8">
        <h3 class="text-xl font-bold text-white mb-2">物语 · AI 角色聊天平台</h3>
        <p class="text-gray-400 text-sm mb-6">
          基于大模型的 AI 角色扮演对话系统，支持微信机器人接入、长期记忆、主动对话等核心能力。
        </p>

        <div class="flex items-baseline gap-2 mb-6">
          <span class="text-3xl font-bold text-white font-mono">¥9.9</span>
          <span class="text-gray-500 text-sm font-mono">起/月</span>
          <span class="text-gray-600 text-xs font-mono">· 月度 · 季度 · 年度套餐可选</span>
        </div>

        <div class="flex flex-wrap gap-4">
          <Button variant="primary" href="/payment">立即开通</Button>
          <Button variant="outline" href="/cases">查看案例</Button>
          <Button variant="outline" href="/blog">社区文章</Button>
        </div>
      </div>
    </div>
  </section>

  <Partners />
</BaseLayout>
