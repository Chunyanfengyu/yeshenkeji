---
import BaseLayout from "../layouts/BaseLayout.astro";
import Badge from "../components/ui/Badge.astro";
---

<BaseLayout title="案例">
  <section class="min-h-screen pt-24 pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">案例</h1>
      <p class="text-gray-500 mb-12 max-w-2xl">
        以下为代表性案例，更多详情请与我们联系。
      </p>

      <!-- 物语 AI 角色聊天平台 -->
      <article class="glass rounded-xl p-6 sm:p-8 mb-8">
        <div class="flex items-start gap-4 mb-6">
          <span class="text-4xl">💬</span>
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-white">物语 · AI 角色聊天平台</h2>
            <p class="text-gray-400 mt-2">
              多实例部署的 AI 角色扮演对话系统，每个实例管理 30 个以内微信机器人账号，
              通过大模型驱动沉浸式角色扮演对话。
            </p>
          </div>
        </div>

        <!-- 项目概览 -->
        <div class="glass rounded-lg p-5 mb-8 bg-white/[0.03]">
          <h3 class="text-lg font-semibold text-white mb-3">项目概述</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            支持多实例部署，当前运行 4 个生产实例 + 1 个测试实例。
            每个实例可管理至多 30 个微信机器人账号，基于大模型实现角色扮演对话，
            覆盖角色设定、长期记忆、主动对话等核心能力。
          </p>
        </div>

        <!-- 后端技术 -->
        <div class="mb-8">
          <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <span class="text-neon-cyan">//</span> 后端架构
          </h3>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-white/10">
                  <th class="text-left text-gray-500 font-medium py-2 pr-4">技术</th>
                  <th class="text-left text-gray-500 font-medium py-2 pr-4">版本</th>
                  <th class="text-left text-gray-500 font-medium py-2">用途</th>
                </tr>
              </thead>
              <tbody class="text-gray-400">
                <tr class="border-b border-white/5"><td class="py-2 pr-4 font-mono text-neon-cyan">Python</td><td class="py-2 pr-4">3.11</td><td class="py-2">运行环境</td></tr>
                <tr class="border-b border-white/5"><td class="py-2 pr-4 font-mono text-neon-cyan">Flask</td><td class="py-2 pr-4">3.1.3</td><td class="py-2">Web 框架，提供 REST API</td></tr>
                <tr class="border-b border-white/5"><td class="py-2 pr-4 font-mono text-neon-cyan">Cheroot</td><td class="py-2 pr-4">11.1.2</td><td class="py-2">生产级 HTTP 服务器</td></tr>
                <tr class="border-b border-white/5"><td class="py-2 pr-4 font-mono text-neon-cyan">Werkzeug</td><td class="py-2 pr-4">3.1.7</td><td class="py-2">WSGI 工具包</td></tr>
                <tr class="border-b border-white/5"><td class="py-2 pr-4 font-mono text-neon-cyan">websockets</td><td class="py-2 pr-4">15.0.1</td><td class="py-2">WebSocket 协议支持</td></tr>
                <tr><td class="py-2 pr-4 font-mono text-neon-cyan">PyInstaller</td><td class="py-2 pr-4">—</td><td class="py-2">打包为 Windows 独立可执行文件</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 前端技术 -->
        <div class="mb-8">
          <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <span class="text-neon-cyan">//</span> 前端架构
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="flex items-start gap-3 glass rounded-lg p-4">
              <span class="text-neon-purple text-lg mt-0.5">▸</span>
              <div>
                <div class="text-white text-sm font-medium">原生 ES Modules</div>
                <div class="text-gray-500 text-xs mt-1">无框架依赖，19 个 ES Module 文件，零构建工具</div>
              </div>
            </div>
            <div class="flex items-start gap-3 glass rounded-lg p-4">
              <span class="text-neon-purple text-lg mt-0.5">▸</span>
              <div>
                <div class="text-white text-sm font-medium">SWR 缓存模式</div>
                <div class="text-gray-500 text-xs mt-1">自定义 Stale-While-Revalidate HTTP 客户端</div>
              </div>
            </div>
            <div class="flex items-start gap-3 glass rounded-lg p-4">
              <span class="text-neon-purple text-lg mt-0.5">▸</span>
              <div>
                <div class="text-white text-sm font-medium">Server-Sent Events</div>
                <div class="text-gray-500 text-xs mt-1">实时流式输出 AI 回复</div>
              </div>
            </div>
            <div class="flex items-start gap-3 glass rounded-lg p-4">
              <span class="text-neon-purple text-lg mt-0.5">▸</span>
              <div>
                <div class="text-white text-sm font-medium">原生 CSS + 主题切换</div>
                <div class="text-gray-500 text-xs mt-1">CSS 自定义属性，支持亮/暗主题，RemixIcon 图标库</div>
              </div>
            </div>
          </div>
        </div>

        <!-- AI 与数据 -->
        <div class="mb-8">
          <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <span class="text-neon-cyan">//</span> AI 与数据处理
          </h3>
          <div class="space-y-3">
            <div class="glass rounded-lg p-4">
              <div class="flex items-center gap-2 mb-2">
                <Badge variant="purple">LLM</Badge>
                <span class="text-white text-sm font-medium">多供应商大模型接入</span>
              </div>
              <p class="text-gray-500 text-xs leading-relaxed">
                主力模型为小米 MIMO v2.5，同时兼容 DeepSeek 及 OpenAI 标准接口，支持灵活切换。
              </p>
            </div>
            <div class="glass rounded-lg p-4">
              <div class="flex items-center gap-2 mb-2">
                <Badge variant="cyan">MCP</Badge>
                <span class="text-white text-sm font-medium">Model Context Protocol</span>
              </div>
              <p class="text-gray-500 text-xs leading-relaxed">
                基于 Anthropic MCP v1.27 协议，集成网页搜索、图片识别等外部工具能力。
              </p>
            </div>
            <div class="glass rounded-lg p-4">
              <div class="flex items-center gap-2 mb-2">
                <Badge variant="purple">记忆系统</Badge>
                <span class="text-white text-sm font-medium">长期对话记忆</span>
              </div>
              <p class="text-gray-500 text-xs leading-relaxed">
                LLM 自动总结对话摘要，按重要性评分管理长期记忆，支持角色主动发起对话。
              </p>
            </div>
          </div>
        </div>

        <!-- 存储方案 -->
        <div class="mb-8">
          <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <span class="text-neon-cyan">//</span> 存储方案
          </h3>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-white/10">
                  <th class="text-left text-gray-500 font-medium py-2 pr-4">类型</th>
                  <th class="text-left text-gray-500 font-medium py-2 pr-4">格式</th>
                  <th class="text-left text-gray-500 font-medium py-2">说明</th>
                </tr>
              </thead>
              <tbody class="text-gray-400">
                <tr class="border-b border-white/5"><td class="py-2 pr-4 text-neon-cyan font-mono">配置文件</td><td class="py-2 pr-4">YAML</td><td class="py-2">LLM 供应商、角色配置、聊天参数</td></tr>
                <tr class="border-b border-white/5"><td class="py-2 pr-4 text-neon-cyan font-mono">对话记录</td><td class="py-2 pr-4">JSON</td><td class="py-2">每次对话完整消息历史</td></tr>
                <tr class="border-b border-white/5"><td class="py-2 pr-4 text-neon-cyan font-mono">账号数据</td><td class="py-2 pr-4">JSON</td><td class="py-2">微信机器人凭证与绑定关系</td></tr>
                <tr class="border-b border-white/5"><td class="py-2 pr-4 text-neon-cyan font-mono">角色设定</td><td class="py-2 pr-4">JSON</td><td class="py-2">30 个角色提示词模板</td></tr>
                <tr><td class="py-2 pr-4 text-neon-cyan font-mono">存储策略</td><td class="py-2 pr-4" colspan="2">全文件系统存储，无 SQL / NoSQL 依赖</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 微信集成 -->
        <div class="mb-4">
          <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <span class="text-neon-cyan">//</span> 微信集成
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="glass rounded-lg p-4 text-center">
              <div class="text-neon-cyan text-lg font-mono font-bold">ilink</div>
              <div class="text-gray-500 text-xs mt-1">微信 ilink 协议</div>
            </div>
            <div class="glass rounded-lg p-4 text-center">
              <div class="text-neon-cyan text-lg font-mono font-bold">扫码登录</div>
              <div class="text-gray-500 text-xs mt-1">扫码认证 + Token 持久化</div>
            </div>
            <div class="glass rounded-lg p-4 text-center">
              <div class="text-neon-cyan text-lg font-mono font-bold">双向路由</div>
              <div class="text-gray-500 text-xs mt-1">微信 ↔ 本地大模型消息路由</div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
