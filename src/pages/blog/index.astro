---
import BaseLayout from "../../layouts/BaseLayout.astro";

const sections = [
  {
    id: "tech",
    name: "技术博客",
    description: "AI、开发、架构等技术领域的深度文章",
    href: "/blog/tech",
    articles: [],
  },
  {
    id: "essay",
    name: "随笔",
    description: "生活记录与兴趣爱好的随性分享",
    href: "/blog/essay",
    articles: [],
  },
  {
    id: "industry",
    name: "行业观察",
    description: "AI 行业动态、趋势分析与市场洞察",
    href: "/blog/industry",
    articles: [],
  },
];

const allArticles = [
  {
    title: "AI 如何重塑人类的情感生活",
    date: "2026-06-01",
    section: "行业观察",
    author: "春风 @夜深科技",
    summary: "从 AI 陪伴到亲密关系重构，探讨人工智能对人类情感生活的深层影响。",
    href: "/blog/ai-emotional-life",
    tags: ["AI", "情感", "社会"],
  },
];
---

<BaseLayout title="社区文章">
  <section class="py-16 sm:py-24">
    <div class="max-w-[1080px] mx-auto px-6 sm:px-12">
      <div class="section-border pb-8 mb-8">
        <h1 class="text-3xl font-bold text-white mb-2">// 社区文章</h1>
        <p class="text-gray-400 text-sm">技术博客、随笔、行业观察——来自夜深科技的思考与分享</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-white/10 mb-12">
        {sections.map((s) => (
          <a href={s.href} class="bg-midnight p-6 group block">
            <h3 class="font-mono text-xs text-gray-500 mb-2">[{s.id}]</h3>
            <h2 class="text-lg font-bold text-white mb-2 group-hover:text-neon-purple transition-colors">{s.name}</h2>
            <p class="text-gray-400 text-sm">{s.description}</p>
          </a>
        ))}
      </div>

      <div class="section-border pb-8 mb-8">
        <h2 class="text-xl font-bold text-white mb-2">// 最新文章</h2>
      </div>

      <div class="space-y-0">
        {allArticles.slice(0, 3).map((article) => (
          <a href={article.href} class="block section-border pb-8 mb-8 group">
            <div class="flex items-start gap-4">
              <span class="font-mono text-gray-500 text-sm mt-1">{article.date}</span>
              <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="font-mono text-xs text-neon-purple border border-neon-purple/30 px-2 py-0.5">{article.section}</span>
                    <span class="font-mono text-xs text-gray-500">{article.author}</span>
                  </div>
                <h3 class="text-lg font-bold text-white mb-2 group-hover:text-neon-purple transition-colors">{article.title}</h3>
                <p class="text-gray-400 text-sm mb-3">{article.summary}</p>
                <div class="flex flex-wrap gap-2">
                  {article.tags.map((tag) => (
                    <span class="font-mono text-xs text-gray-500 border border-white/10 px-2 py-0.5">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
