---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="博客">
  <section class="min-h-screen pt-24 pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">博客</h1>
      <p class="text-gray-500 mb-12 max-w-2xl">
        技术文章、行业洞察与团队思考。内容持续更新中。
      </p>

      <div class="glass rounded-xl p-12 text-center">
        <p class="text-gray-500 text-lg mb-2">暂无文章</p>
        <p class="text-gray-600 text-sm">博客内容正在建设中，敬请期待...</p>
      </div>
    </div>
  </section>
</BaseLayout>
