---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/sections/ContactForm.astro";
---

<BaseLayout title="联系我们">
  <section class="py-16 sm:py-24">
    <div class="max-w-[1080px] mx-auto px-6 sm:px-12">
      <div class="section-border pb-8 mb-8">
        <h1 class="text-3xl font-bold text-white mb-2">// 联系我们</h1>
        <p class="text-gray-400 text-sm">有任何问题或合作意向？我们将在 24 小时内与您取得联系。</p>
      </div>

      <div class="max-w-2xl">
        <ContactForm />
      </div>

      <div class="mt-12 border border-white/10 p-6">
        <h2 class="font-mono text-sm font-bold text-white mb-4">[联系信息]</h2>
        <div class="space-y-2 text-sm text-gray-400">
          <p class="font-mono"><span class="text-gray-500">地址:</span> 河北省唐山市路北区龙仁里清科园</p>
          <p class="font-mono"><span class="text-gray-500">邮箱:</span> <span id="email-obfuscate" class="cursor-pointer" onclick="this.textContent=atob('Y2h1bmZlbmcmeWVzaGVuLnRlY2g=').replace('&','@')">[点击显示]</span></p>
          <p class="font-mono"><span class="text-gray-500">工作时间:</span> 周一至周五 9:00 - 18:00</p>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
