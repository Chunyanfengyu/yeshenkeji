---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/sections/ContactForm.astro";
---

<BaseLayout title="联系我们">
  <section class="min-h-screen pt-24 pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">联系我们</h1>
      <p class="text-gray-500 mb-8 max-w-2xl">
        有任何问题或合作意向？请填写下方表单，我们将在 24 小时内与您取得联系。
      </p>

      <ContactForm />

      <div class="mt-12 glass rounded-xl p-6">
        <h2 class="text-lg font-semibold text-white mb-4">联系信息</h2>
        <div class="space-y-2 text-sm text-gray-400">
          <p>
            <span class="text-gray-500">地址：</span>
            河北省唐山市路北区龙仁里清科园
          </p>
          <p>
            <span class="text-gray-500">邮箱：</span>
            chunfeng@yeshen.tech
          </p>
          <p>
            <span class="text-gray-500">工作时间：</span>
            周一至周五 9:00 - 18:00
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
