---
export interface Props {
  variant?: "primary" | "outline";
  size?: "sm" | "md" | "lg";
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
}

const { variant = "primary", size = "md", href, type = "button" } = Astro.props;

const base = "inline-flex items-center justify-center font-mono font-medium transition-colors duration-200 rounded-btn focus:outline-none";

const variants = {
  primary: "bg-neon-purple text-white hover:bg-neon-purple/90",
  outline: "border border-neon-purple/50 text-neon-purple hover:bg-neon-purple/10",
};

const sizes = {
  sm: "px-3 py-1.5 text-xs",
  md: "px-4 py-2 text-sm",
  lg: "px-6 py-2.5 text-sm",
};

const classes = `${base} ${variants[variant]} ${sizes[size]} ${Astro.props.class || ""}`;
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
