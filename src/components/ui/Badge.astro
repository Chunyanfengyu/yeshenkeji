---
export interface Props {
  variant?: "default" | "purple" | "cyan";
  class?: string;
}

const { variant = "default" } = Astro.props;

const variants = {
  default: "border-white/10 text-gray-400",
  purple: "border-neon-purple/30 text-neon-purple",
  cyan: "border-neon-cyan/30 text-neon-cyan",
};
---

<span class={`inline-flex items-center px-2 py-0.5 text-xs font-mono border ${variants[variant]} ${Astro.props.class || ""}`}>
  <slot />
</span>
