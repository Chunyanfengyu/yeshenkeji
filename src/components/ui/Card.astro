---
export interface Props {
  title: string;
  description?: string;
  icon?: string;
  href?: string;
  class?: string;
}

const { title, description, icon, href } = Astro.props;
---

<article class={`glass glass-hover rounded-xl p-6 ${Astro.props.class || ""}`}>
  {icon && <div class="text-3xl mb-4">{icon}</div>}
  <h3 class="text-xl font-bold text-white mb-2">{title}</h3>
  {description && <p class="text-gray-400 text-sm leading-relaxed">{description}</p>}
  {href && (
    <a href={href} class="mt-4 inline-flex items-center text-neon-purple text-sm font-medium hover:text-neon-cyan transition-colors">
      了解更多 &rarr;
    </a>
  )}
</article>
