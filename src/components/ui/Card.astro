---
import Badge from "./Badge.astro";

export interface Stat {
  label: string;
  value: string;
}

export interface Props {
  title: string;
  description?: string;
  icon?: string;
  href?: string;
  tags?: string[];
  stats?: Stat[];
  class?: string;
}

const { title, description, icon, href, tags, stats } = Astro.props;
---

<article class={`glass glass-hover rounded-xl p-6 flex flex-col ${Astro.props.class || ""}`}>
  <div class="flex items-start gap-4 mb-3">
    {icon && <div class="text-3xl flex-shrink-0">{icon}</div>}
    <div class="flex-1 min-w-0">
      <h3 class="text-xl font-bold text-white">{title}</h3>
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-2">
          {tags.map((tag) => <Badge variant="default" class="text-[10px] px-2 py-0.5">{tag}</Badge>)}
        </div>
      )}
    </div>
  </div>
  {description && <p class="text-gray-400 text-sm leading-relaxed flex-1">{description}</p>}

  {stats && stats.length > 0 && (
    <div class="flex gap-4 mt-4 pt-3 border-t border-white/5">
      {stats.map((s) => (
        <div class="flex items-center gap-1 text-xs text-gray-500">
          <span class="text-neon-cyan font-mono font-semibold">{s.value}</span>
          <span>{s.label}</span>
        </div>
      ))}
    </div>
  )}

  {href && (
    <a href={href} class="mt-4 inline-flex items-center text-neon-purple text-sm font-medium hover:text-neon-cyan transition-colors">
      了解更多 &rarr;
    </a>
  )}
</article>
