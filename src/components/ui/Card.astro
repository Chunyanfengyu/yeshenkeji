---
export interface Props {
  title: string;
  description?: string;
  icon?: string;
  href?: string;
  class?: string;
}

const { title, description, icon, href } = Astro.props;
---

<div class={`border border-white/10 ${Astro.props.class || ""}`}>
  <a href={href} class="block p-6 no-underline group">
    <div class="flex items-start gap-3 mb-2">
      {icon && <span class="font-mono text-gray-500 text-sm mt-0.5">{icon}</span>}
      <h3 class="font-bold text-white group-hover:text-neon-purple transition-colors">{title}</h3>
    </div>
    {description && <p class="text-gray-400 text-sm ml-8">{description}</p>}
    {href && (
      <div class="mt-3 ml-8 font-mono text-xs text-gray-500 group-hover:text-neon-purple transition-colors">
        &rarr; 了解更多
      </div>
    )}
  </a>
</div>
