---
const partners: string[] = [];
---

<section class="py-24 bg-deepgray/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-white text-center mb-4">生态伙伴</h2>
    <p class="text-gray-500 text-center mb-12 max-w-xl mx-auto">
      合作伙伴持续招募中
    </p>
    {partners.length > 0 && (
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        {partners.map((name) => (
          <div class="glass rounded-lg p-6 flex items-center justify-center h-20 hover:border-neon-purple/30 transition-colors">
            <span class="text-gray-500 text-sm font-medium tracking-wide">{name}</span>
          </div>
        ))}
      </div>
    )}
    {partners.length === 0 && (
      <div class="glass rounded-xl p-12 text-center">
        <p class="text-gray-500">暂无合作伙伴信息</p>
      </div>
    )}
  </div>
</section>
