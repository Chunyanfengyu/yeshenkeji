---
const partners: string[] = [];
---

<section class="py-16 sm:py-24 bg-deepgray/50">
  <div class="max-w-[1080px] mx-auto px-6 sm:px-12">
    <div class="section-border pb-8 mb-8">
      <h2 class="text-2xl font-bold text-white mb-2">// 生态伙伴</h2>
      <p class="text-gray-400 text-sm">合作伙伴持续招募中</p>
    </div>

    {partners.length > 0 && (
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-px bg-white/10">
        {partners.map((name) => (
          <div class="bg-midnight p-6 flex items-center justify-center h-20">
            <span class="text-gray-500 text-sm font-mono">{name}</span>
          </div>
        ))}
      </div>
    )}
    {partners.length === 0 && (
      <div class="border border-white/10 p-12 text-center">
        <p class="text-gray-500 font-mono text-sm">$ echo "暂无合作伙伴信息"</p>
      </div>
    )}
  </div>
</section>
