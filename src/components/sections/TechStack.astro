---
const techs = [
  "Python", "PyTorch", "TensorFlow", "ROS", "Go",
  "Rust", "React", "TypeScript", "Node.js", "PostgreSQL",
  "Docker", "Kubernetes", "AWS", "Linux", "Git",
];
---

<section class="py-16 sm:py-24">
  <div class="max-w-[1080px] mx-auto px-6 sm:px-12">
    <div class="section-border pb-8 mb-8">
      <h2 class="text-2xl font-bold text-white mb-2">// 技术栈</h2>
      <p class="text-gray-400 text-sm">我们使用的核心技术</p>
    </div>

    <div class="grid grid-cols-3 sm:grid-cols-5 gap-px bg-white/10">
      {techs.map((t) => (
        <div class="bg-midnight p-4 text-center">
          <span class="font-mono text-sm text-gray-400">{t}</span>
        </div>
      ))}
    </div>
  </div>
</section>
