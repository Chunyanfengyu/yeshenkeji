---
import Button from "../ui/Button.astro";
---

<section class="py-24 bg-deepgray/50">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-white text-center mb-4">联系我们</h2>
    <p class="text-gray-500 text-center mb-12 max-w-xl mx-auto">
      告诉我们您的需求，我们将在 24 小时内回复
    </p>

    <form id="contact-form" class="glass rounded-xl p-6 sm:p-8 space-y-6" data-netlify="true" name="contact">
      <input type="hidden" name="form-name" value="contact" />

      <div>
        <label for="name" class="block text-sm font-medium text-gray-300 mb-2">姓名</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder="您的姓名"
          class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white placeholder-gray-600 focus:outline-none focus:border-neon-purple/50 focus:ring-1 focus:ring-neon-purple/30 transition-colors"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-gray-300 mb-2">邮箱</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="your@email.com"
          class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white placeholder-gray-600 focus:outline-none focus:border-neon-purple/50 focus:ring-1 focus:ring-neon-purple/30 transition-colors"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-gray-300 mb-2">需求描述</label>
        <textarea
          id="message"
          name="message"
          required
          rows="5"
          placeholder="请描述您的项目需求..."
          class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white placeholder-gray-600 focus:outline-none focus:border-neon-purple/50 focus:ring-1 focus:ring-neon-purple/30 transition-colors resize-none"
        ></textarea>
      </div>

      <Button variant="primary" size="lg" type="submit" class="w-full">发送消息</Button>
    </form>
  </div>
</section>
