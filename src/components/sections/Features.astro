---
import Card from "../ui/Card.astro";

const features = [
  {
    icon: "🤖",
    title: "AI 软件开发",
    description: "基于大模型与深度学习的智能系统开发，从 NLP 到计算机视觉，提供企业级 AI 解决方案。",
    href: "/solutions/ai-software",
  },
  {
    icon: "⚙️",
    title: "机器人技术",
    description: "ROS 驱动的机器人系统集成、自主导航与机械臂控制，助力工业与服务业智能化升级。",
    href: "/solutions/robotics",
  },
  {
    icon: "🎨",
    title: "数字创意",
    description: "沉浸式交互体验、实时渲染与数字孪生，用技术赋能创意表达。",
    href: "/solutions/digital-creative",
  },
  {
    icon: "🔬",
    title: "技术咨询",
    description: "为初创企业与传统企业提供技术架构评估、AI 落地路径规划与团队培训服务。",
    href: "/contact",
  },
];
---

<section class="py-24 bg-deepgray/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-white text-center mb-4">核心业务</h2>
    <p class="text-gray-500 text-center mb-12 max-w-xl mx-auto">
      四项主营业务，覆盖 AI 时代的技术需求
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((f) => (
        <Card title={f.title} description={f.description} icon={f.icon} href={f.href} />
      ))}
    </div>
  </div>
</section>
