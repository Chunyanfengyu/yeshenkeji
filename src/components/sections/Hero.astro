---
import Button from "../ui/Button.astro";
---

<section class="py-16 sm:py-24">
  <div class="max-w-[1080px] mx-auto px-6 sm:px-12">
    <div class="section-border pb-12">
      <div class="flex items-center gap-2 mb-6">
        <span class="font-mono text-gray-500 text-sm">[</span>
        <span class="font-mono text-gray-500 text-xs">NIGHT TECH</span>
        <span class="font-mono text-gray-500 text-sm">]</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4 leading-tight">
        夜深科技
      </h1>
      <p class="font-mono text-lg text-gray-500 mb-2">Noctis Tech</p>
      <p class="text-gray-400 max-w-xl mb-8 leading-relaxed">
        在静谧的深夜，用代码构建智能的未来。<br />
        深耕 AI、机器人技术与数字创意。
      </p>

      <div class="flex flex-wrap gap-4">
        <Button variant="primary" size="lg" href="/payment">立即开通</Button>
        <Button variant="outline" size="lg" href="/cases">查看案例</Button>
        <Button variant="outline" size="lg" href="/blog">社区文章</Button>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-0 border border-white/10 mt-0">
      <div class="p-6 text-center border-r border-white/10">
        <div class="text-2xl font-bold text-white font-mono">1</div>
        <div class="text-xs text-gray-500 font-mono mt-1">负责人</div>
      </div>
      <div class="p-6 text-center border-r border-white/10">
        <div class="text-2xl font-bold text-white font-mono">3</div>
        <div class="text-xs text-gray-500 font-mono mt-1">项目组</div>
      </div>
      <div class="p-6 text-center">
        <div class="text-2xl font-bold text-white font-mono">5</div>
        <div class="text-xs text-gray-500 font-mono mt-1">团队成员</div>
      </div>
    </div>
  </div>
</section>
