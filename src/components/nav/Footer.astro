---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-midnight">
  <div class="max-w-[1080px] mx-auto px-6 sm:px-12 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div class="col-span-2 md:col-span-1">
        <h3 class="font-mono font-bold text-white mb-3 tracking-wider">YESHEN</h3>
        <p class="text-sm text-gray-500">
          河北省夜深科技有限责任公司
        </p>
      </div>
      <div>
        <h4 class="font-mono text-xs text-gray-500 mb-3">[导航]</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="text-gray-400 hover:text-neon-purple transition-colors">首页</a></li>
          <li><a href="/about" class="text-gray-400 hover:text-neon-purple transition-colors">关于</a></li>
          <li><a href="/cases" class="text-gray-400 hover:text-neon-purple transition-colors">案例</a></li>
          <li><a href="/contact" class="text-gray-400 hover:text-neon-purple transition-colors">联系</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-mono text-xs text-gray-500 mb-3">[业务]</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/solutions/ai-software" class="text-gray-400 hover:text-neon-purple transition-colors">AI 软件开发</a></li>
          <li><a href="/solutions/digital-creative" class="text-gray-400 hover:text-neon-purple transition-colors">数字创意</a></li>
          <li><a href="/payment" class="text-gray-400 hover:text-neon-purple transition-colors">付费方案</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-mono text-xs text-gray-500 mb-3">[联系]</h4>
        <address class="not-italic text-sm text-gray-500 space-y-2">
          <p>河北省唐山市路北区</p>
          <p>chunfeng@yeshen.tech</p>
        </address>
      </div>
    </div>
    <div class="mt-8 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-gray-600">
      <span class="font-mono">&copy; {currentYear} 夜深科技</span>
    </div>
  </div>
</footer>
