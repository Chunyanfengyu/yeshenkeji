---
import Button from "../ui/Button.astro";

const navLinks = [
  { href: "/", label: "首页" },
  { href: "/about", label: "关于" },
  { href: "/cases", label: "案例" },
  { href: "/blog", label: "社区文章" },
  { href: "/payment", label: "付费" },
  { href: "/contact", label: "联系" },
];
---

<nav class="sticky top-0 z-50 bg-midnight/95 backdrop-blur-sm border-b border-white/10">
  <div class="max-w-[1080px] mx-auto px-6 sm:px-12 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      <span class="font-mono font-bold text-lg text-white tracking-wider">YESHEN</span>
    </a>

    <div class="hidden md:flex items-center gap-8">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="font-mono text-sm text-gray-400 hover:text-white transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <button
      id="menu-toggle"
      class="md:hidden text-gray-400 hover:text-white p-2 font-mono text-sm"
      aria-label="菜单"
    >
      [菜单]
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-white/10 bg-midnight">
    <div class="px-6 py-4 space-y-3">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="block font-mono text-sm text-gray-400 hover:text-white transition-colors py-2"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });
  }
</script>
